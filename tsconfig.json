{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [ "ES2023" ],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": [ "node" ],
		"strict": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [ "src/**/*.ts" ]
}
