{
	"name": "upload-safety",
	"version": "0.2.0",
	"description": "Server-side upload checks for Node: extension/MIME allowlist, magic bytes, refusal of macros, embedded objects, DDE, PDF scripts, CSV formulas and encrypted files, metadata stripping for JPEG, PNG, WebP, HEIC and AVIF.",
	"keywords": [
		"upload",
		"file-upload",
		"security",
		"validation",
		"magic-bytes",
		"macro",
		"vba",
		"ole",
		"ooxml",
		"pdf",
		"exif",
		"metadata",
		"heic",
		"webp",
		"avif",
		"csv-injection"
	],
	"license": "MIT",
	"author": "Simon Halimonov (https://www.simonhalimonov.com)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simulieren/upload-safety.git"
	},
	"homepage": "https://upload-safety.simonhalimonov.com",
	"bugs": {
		"url": "https://github.com/simulieren/upload-safety/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/*-fixture.ts",
		"!src/__fixtures__"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepare": "npm run build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run typecheck && npm test"
	},
	"devDependencies": {
		"@types/node": "22.15.29",
		"typescript": "5.8.3",
		"vitest": "3.2.4"
	}
}
