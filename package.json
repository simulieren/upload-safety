{
	"name": "upload-safety",
	"version": "0.1.0",
	"private": true,
	"description": "Server-side upload checks for Node: extension/MIME allowlist, magic bytes, Office/ODF macro and encryption detection, PDF encryption, photo metadata stripping.",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/*-fixture.ts",
		"!src/__fixtures__"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepare": "npm run build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "22.15.29",
		"typescript": "5.8.3",
		"vitest": "3.2.4"
	}
}
